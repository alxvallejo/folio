{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.2.0",
  "identifier": "com.alexvallejo.folio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Folio", "width": 1200, "height": 850, "minWidth": 640, "minHeight": 400 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; form-action 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["$HOME/**"], "requireLiteralLeadingDot": false }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["md", "markdown"], "name": "Markdown Document", "role": "Viewer", "mimeType": "text/markdown" }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwRTNGMjI0MjVEQUExMDYKUldRR29kb2xKUExqVU1IZHB5UmNPWGdzTU55WUwxQk9IVFpXeHZGeXhmb3BDSTdHUnpjcWcwS1gK",
      "endpoints": ["https://github.com/alxvallejo/folio/releases/latest/download/latest.json"]
    }
  }
}
